#!/usr/bin/env bash
# PATH shim: anything that resolves "claude-code" via PATH lands here.
# Place this file at ~/.local/bin/claude-code (must come before the real
# binary's directory in PATH) and `chmod +x` it.

set -euo pipefail

EXEC_GUARD="${EXEC_GUARD:-/opt/exec-guard/bin/exec-guard}"
REAL_BIN="${CLAUDE_CODE_REAL:-/opt/claude-code-real/claude-code}"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/exec-guard"
LOG_FILE="$LOG_DIR/claude-code-denied.jsonl"

mkdir -p "$LOG_DIR"

exec "$EXEC_GUARD" --log "$LOG_FILE" -- "$REAL_BIN" "$@"